{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bookmarks-sync",
	"compatibility_date": "2026-07-06",
	"compatibility_flags": ["nodejs_als"],
	// Custom entry wrapping the SvelteKit build output to add scheduled()
	"main": "src/worker.ts",
	// Hourly sync (free CF cron; deliberately not a Modal slot). Each run spends at
	// most MAX_GITHUB_WRITES GitHub writes, so a large backlog drains over hours.
	"triggers": { "crons": ["0 * * * *"] },
	// The sync base (last agreed state) lives in one SQLite-backed Durable Object.
	"durable_objects": { "bindings": [{ "name": "SYNC_STATE", "class_name": "SyncState" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncState"] }],
	// Plain config (not a secret): the soma hub this Worker writes bookmarks to
	"vars": { "SOMA_HUB_URL": "https://soma.nqipomyrjb.workers.dev" },
	// Workers cannot fetch a sibling workers.dev Worker over the network (CF error
	// 1042), so the hub's HTTP API is reached through a service binding; the
	// request shape and the SOMA_HUB_TOKEN auth are unchanged.
	"services": [{ "binding": "SOMA_HUB", "service": "soma" }],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true
}
