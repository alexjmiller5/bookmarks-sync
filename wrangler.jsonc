{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bookmarks-sync",
	"compatibility_date": "2026-07-06",
	"compatibility_flags": ["nodejs_als"],
	// Custom entry wrapping the SvelteKit build output to add scheduled()
	"main": "src/worker.ts",
	// Daily sync at 06:00 UTC (free CF cron; deliberately not a Modal slot)
	"triggers": { "crons": ["0 6 * * *"] },
	// Plain config (not a secret): the life-data hub this Worker writes bookmarks to
	"vars": { "LIFE_HUB_URL": "https://life-data.nqipomyrjb.workers.dev" },
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true
}
