// Build-time config for @sveltejs/adapter-cloudflare ONLY (see vite.config.ts).
// The adapter writes its generated worker to `main` of whatever config it reads;
// pointing it here keeps it from clobbering src/worker.ts (the real entrypoint,
// which wraps this build output to add scheduled()). Deploys use wrangler.jsonc.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bookmarks-sync",
	"compatibility_date": "2026-07-06",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
